# SMTP settings used by: python jobwatch.py run --email
# Gmail example (use an App Password, not your account password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password-here
EMAIL_TO=you@gmail.com

# Optional: override the From: header (defaults to SMTP_USER)
# EMAIL_FROM=jobwatch@example.com

# USAJOBS (federal jobs) - free key from https://developer.usajobs.gov
# USAJOBS_EMAIL must be the address you registered the key with; it is sent as
# the User-Agent header, which USAJOBS requires. NEVER commit the key - .env is
# gitignored, .env.example is not.
USAJOBS_EMAIL=you@example.com
USAJOBS_KEY=your-usajobs-api-key-here
